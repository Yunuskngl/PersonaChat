{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Urls": "http://localhost:5080",
  "Llm": {
    "Provider": "Ollama",
    "Ollama": {
      "Url": "http://localhost:11434/api/chat",
      "Model": "gemma3:4b",
      "NumCtx": 4096,
      "MaxReplyTokens": 600,
      "TimeoutSeconds": 300,
      "MaxLongReplyTokens": 2000
    },
    "Claude": {
      "Model": "claude-opus-5-5",
      "MaxTokens": 16000,
      "TimeoutSeconds": 120
    },
    "OpenAi": {
      "Model": "",
      "Url": "https://api.openai.com/v1/responses",
      "MaxTokens": 16000,
      "TimeoutSeconds": 120
    },
    "Gemini": {
      "Model": "",
      "Url": "https://generativelanguage.googleapis.com/v1beta/models",
      "MaxTokens": 16000,
      "TimeoutSeconds": 120
    },
    "OpenAiCompatible": {
      "Model": "",
      "Url": "",
      "MaxTokens": 16000,
      "TimeoutSeconds": 120
    }
  },
  "Chat": {
    "MaxInputLength": 2000,
    "MaxDisplayMessages": 200,
    "IntroMessages": 6,
    "FriendMessages": 24
  },
  "Memory": {
    "ShortTermMessages": 20,
    "SummarizeEvery": 20,
    "MaxNotes": 30,
    "MaxNoteLength": 200
  },
  "Reports": {
    "MinWords": 8,
    "MaxEmailLength": 3000,
    "ChunkChars": 3000,
    "MaxItemsPerChunk": 15,
    "MaxFieldLength": 400,
    "MaxRewriteLength": 4000
  }
}
